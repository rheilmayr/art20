left_join(df_all3, by = "source") %>%
mutate(
p_label = sprintf("p=%.3f", pval)
)
rename_fun <- function(x) case_when(
x == "biodiv" ~ "Biodiversity",
x == "log_carbon" ~ "Log(Carbon)",
x == "trees_lowero" ~ "Trees - Low Erosion",
x == "trees_highero" ~ "Trees - High Erosion"
)
df_all <- df_all %>% mutate(source = rename_fun(source))
df_all2 <- df_all2 %>% mutate(source = rename_fun(source))
order_levels <- c(
"Biodiversity",
"Log(Carbon)",
"Trees - High Erosion",
"Trees - Low Erosion"
)
labels_full <- c(
"Biodiversity",
"Log(Carbon)",
"Trees - High Erosion",
"Trees - Low Erosion"
)
df_all$source <- factor(df_all$source, levels = order_levels, labels = labels_full)
df_all2$source <- factor(df_all2$source, levels = order_levels, labels = labels_full)
df_all2 <- df_all2 %>%
mutate(
z = coef / stderr,
p_value = 2 * (1 - pnorm(abs(z))),
p_label = sprintf("p=%.3f", p_value)
)
ci_band <- df_all2 %>%
group_by(source) %>%
summarise(
mean_coef = mean(coef),
mean_stderr = mean(stderr),
.groups = "drop"
) %>%
mutate(
ymin = mean_coef - 1.96 * mean_stderr,
ymax = mean_coef + 1.96 * mean_stderr
)
panel_labels <- df_all %>%
group_by(source) %>%
summarise(
x = -10,
y = 0.11,
.groups = "drop"
) %>%
mutate(
label = c("a", "b", "c", "d")
)
BIO <- ggplot(df_all, aes(x = relative, y = coef)) +
geom_ribbon(aes(
ymin = coef - 1.96 * stderr,
ymax = coef + 1.96 * stderr
), fill = "gray80", alpha = 0.5) +
geom_line(color = "steelblue", linewidth = 0.6) +
geom_point(
data = df_all2,
aes(x = relative, y = coef),
color = "red",
size = 1.5,
inherit.aes = FALSE
) +
geom_errorbar(
data = df_all2,
aes(
x = relative,
ymin = coef - 1.96 * stderr,
ymax = coef + 1.96 * stderr
),
color = "red",
width = 0.15,
linewidth = 0.4,
inherit.aes = FALSE
) +
geom_text(
data = df_all2,
aes(
x = relative,
y = coef - 1.96 * stderr - 0.01,
label = p_label
),
size = 2,
vjust = 1,
family = "Arial",
inherit.aes = FALSE
) +
geom_segment(
aes(x = -10, xend = 10, y = 0, yend = 0),
linetype = "dashed",
color = "black",
inherit.aes = FALSE
) +
facet_wrap(~ source) +
scale_x_continuous(
