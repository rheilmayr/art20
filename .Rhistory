aes(x = x, y = y, label = label),
hjust = -0.2,
vjust = 1.2,
size = 3.6,
family = "Arial",
fontface = "bold",
fill = "white",
color = "black",
label.size = 0,
inherit.aes = FALSE
)+
theme_minimal(base_family = "Arial", base_size = 7) +
theme(
text = element_text(family = "Arial", size = 7),
