. *** Table A12: Heterogeneous effects by predominant land use at baseline (2001)
. ***********************************************************
. 
. egen tt=rowmax(grass crop natural plantation)  if year==2001
(28,386 missing values generated)

. foreach var of varlist grass crop natural plantation{
  2.         gen T_basemax`var'=0
  3.     replace T_basemax`var'=1 if `var'==tt
  4.         bysort objectid: egen tt2=max(T_basemax`var')
  5.         replace T_basemax`var'=1 if T_basemax`var'!=tt2
  6.         gen FTAI_basemax_`var'=FTAI*T_basemax`var'
  7.         drop tt2
  8. }
(918 real changes made)
(16,524 real changes made)
(190 real changes made)
(3,420 real changes made)
(313 real changes made)
(5,634 real changes made)
(160 real changes made)
(2,880 real changes made)

. drop tt

. 
. 
. estimates clear

. foreach var of varlist grass crop natural plantation{
  2. xtreg `var'  FTAI_basemax* i.year lclim_*, fe vce(cluster community_ID)
  3. estadd scalar clusters= e(N_clust)
  4. estadd scalar plots= e(N_g)
  5. sum `var' if e(sample)
  6. estadd scalar mean_depvar= r(mean)
  7. est sto twfe_base_`var'
  8. }

