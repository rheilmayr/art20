> munity_ID)
  3. estadd scalar clusters= e(N_clust)
  4. estadd scalar plots= e(N_g)
  5. sum `var' if e(sample)
  6. estadd scalar mean_depvar= r(mean)
  7. est sto twfe_conflpj_`var'
  8. 
. }

